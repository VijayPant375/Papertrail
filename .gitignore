# =============================================================================
# Papertrail — fact-knowledge-layer .gitignore
# =============================================================================

# ----- Secrets & environment -------------------------------------------------
.env
*.env
!.env.example

# ----- Database files --------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ----- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/
.Python

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/

# Type-checking & linting caches
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/

# pytest
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# ----- Uploaded / generated files -------------------------------------------
# Temporary PDFs written during upload processing
*.tmp
tmp_*.pdf

# Pipeline output samples (keep .gitkeep, ignore everything else)
sample_output/*
!sample_output/.gitkeep

# ----- IDEs & editors --------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- OS -------------------------------------------------------------------
desktop.ini
ehthumbs.db
